{
  "name": "mukure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test src/subtitles.test.ts",
    "tauri": "sh scripts/with-rust.sh tauri",
    "check:rust": "sh scripts/with-rust.sh cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "test:rust": "sh scripts/with-rust.sh cargo test --locked --manifest-path src-tauri/Cargo.toml --lib",
    "media:build": "sh scripts/build-media.sh",
    "licenses:generate": "sh scripts/with-rust.sh node scripts/third-party-notices.mjs",
    "prepare:app": "pnpm media:build && pnpm licenses:generate",
    "release": "sh scripts/release.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "description": "Desktop video player with torrents, subtitles and Chromecast",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alvarotala/mukure.git"
  },
  "homepage": "https://github.com/alvarotala/mukure#readme",
  "bugs": {
    "url": "https://github.com/alvarotala/mukure/issues"
  }
}
