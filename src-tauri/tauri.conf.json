{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mukure",
  "version": "0.1.1",
  "identifier": "app.mukure.player",
  "build": {
    "beforeDevCommand": "pnpm prepare:app && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm prepare:app && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mukure",
        "width": 1120,
        "height": 740,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "maximizable": true,
        "backgroundColor": "#101210"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; media-src 'self' http://127.0.0.1:* blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Video",
    "shortDescription": "Reproductor local de video y torrents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/media/bin/": "bin/",
      "resources/media/licenses/": "third-party/media/licenses/",
      "resources/media/sources/": "third-party/media/sources/",
      "resources/notices/": "third-party/dependencies/",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY.md": "THIRD_PARTY.md"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "copyright": "Copyright \u00a9 2026 alvarotala and Mukure contributors"
  }
}
