{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mukure",
  "version": "0.1.0",
  "identifier": "app.mukure.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Mukure",
      "width": 1280,
      "height": 850,
      "minWidth": 920,
      "minHeight": 640,
      "backgroundColor": "#111311"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; media-src 'self' http://127.0.0.1:* blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Video",
    "shortDescription": "Reproductor local de video y torrents",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../node_modules/@ffmpeg-installer/darwin-arm64/ffmpeg": "bin/ffmpeg",
      "../node_modules/@ffprobe-installer/darwin-arm64/ffprobe": "bin/ffprobe"
    },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
